{
  "expo": {
    "name": "Videeko Mobile",
    "slug": "videeko-vanilla",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.jpg",
    "scheme": "videeko",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "enabled": false
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "L'app a besoin d'accès à votre appareil photo pour scanner les codes QR",
        "NSLocationWhenInUseUsageDescription": "L'app a besoin de votre position pour enregistrer les collectes et inspections."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo.jpg",
        "backgroundImage": "./assets/images/logo.jpg",
        "monochromeImage": "./assets/images/logo.jpg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "package": "com.misaina23.videeko.vanilla",
      "windowSoftInputMode": "adjustResize",
      "navigationBarColor": "#FFFFFF",
      "statusBarColor": "#0D9488",
      "statusBarStyle": "light"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/logo.jpg"
    },
    "extra": {
      "apiUrl": "https://gestion-agricole-1-ajdy.onrender.com",
      "eas": {
        "projectId": "a1bb272b-3ca4-4531-ba4d-5b01162d60a0"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "L'app a besoin d'accès à votre appareil photo pour scanner les codes QR"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "./plugins/withRemoveEnableBundleCompression.js"
    ],
    "owner": "misaina23"
  }
}