{
  "expo": {
    "name": "Vintsy Mobile",
    "slug": "vintsy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "vintsy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "enabled": false
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "L'app a besoin d'accès à votre appareil photo pour scanner les codes QR",
        "NSLocationWhenInUseUsageDescription": "L'app a besoin de votre position pour enregistrer les collectes et inspections."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "package": "com.misaina23.vintsy"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/logo.png"
    },
    "extra": {
      "apiUrl": "https://gestion-agricole-1-ajdy.onrender.com",
      "eas": {
        "projectId": "84472b06-84cf-4e2e-b0e8-f52e5583b2b0"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "L'app a besoin d'accès à votre appareil photo pour scanner les codes QR"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "./plugins/withRemoveEnableBundleCompression.js",
      "@react-native-community/datetimepicker"
    ],
    "owner": "misaina23"
  }
}