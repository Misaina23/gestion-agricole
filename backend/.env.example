# VIDEEKO VANILLA - Configuration Environnement

# Django Settings
DEBUG=True
DJANGO_SECRET_KEY=your-secret-key-change-in-production

# Database PostgreSQL
DB_NAME=videeko_vanilla
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Allowed Hosts
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.131,192.168.137.65

# Public API URL reachable from mobile/web clients
API_URL=http://192.168.1.131:8000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081,http://192.168.1.131:3000,http://192.168.1.131:8081
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081,http://192.168.1.131:3000,http://192.168.1.131:8081

# Django Log Level
DJANGO_LOG_LEVEL=INFO

# AI LLM config (add your provider API key to enable LLM proxy)
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_RATE_LIMIT=20
LLM_RATE_PERIOD=60
LLM_MAX_TOKENS=2048
